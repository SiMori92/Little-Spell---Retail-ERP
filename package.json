{
  "name": "little-spell-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.0.0 <23" },
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "tsx --conditions=react-server scripts/start.ts dev",
    "build": "tsx scripts/check-node.ts && next build",
    "start": "tsx --conditions=react-server scripts/start.ts start",
    "test": "vitest run",
    "e2e": "playwright test",
    "smoke": "tsx --conditions=react-server scripts/smoke.ts",
    "lint": "eslint . && tsx --conditions=react-server scripts/money-guard.ts",
    "typecheck": "tsc --noEmit",
    "guard": "tsx scripts/repo-guard.ts",
    "backup": "tsx --conditions=react-server scripts/backup.ts",
    "restore": "tsx --conditions=react-server scripts/restore.ts",
    "reset:sample": "tsx --conditions=react-server scripts/reset-sample.ts",
    "prepare": "tsx --conditions=react-server scripts/setup-hook.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "async-mutex": "^0.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "recharts": "^3.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "write-file-atomic": "^6.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^22.19.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/write-file-atomic": "^4.0.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
